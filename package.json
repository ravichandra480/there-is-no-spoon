  "scripts": {
    "verify": "nx run workspace:verify"
  },
  "nx": {
    "name": "workspace",
    "tags": [
      "type:util",
      "scope:workspace"
    ],
    "includedScripts": [],
    "targets": {
      "verify": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "node tools/scripts/check-nx-versions.mjs",
            "node tools/scripts/check-boundaries.mjs"
          ],
          "parallel": false,
          "cwd": "{workspaceRoot}"
        }
      }
    }
  },
