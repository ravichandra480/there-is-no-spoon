{
  "name": "demo",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "demo",
  "sourceRoot": "apps/demo/src",
  "tags": ["type:app", "scope:demo"],
  "targets": {
    "build-gh-pages": {
      "command": "vite build --mode gh-pages",
      "options": { "cwd": "apps/demo" },
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{workspaceRoot}/dist/apps/demo-gh-pages"]
    }
  },
  "// targets": "build, serve, preview, serve-static and test are inferred from vite.config.mts by @nx/vite and @nx/vitest"
}
